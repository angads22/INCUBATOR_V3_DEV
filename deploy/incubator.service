[Unit]
Description=Incubator v3 web app
# Start the app even if the network isn't fully up yet — it manages its own
# Wi-Fi hotspot for onboarding, so it must not wait on network-online at first
# boot (there is no network then). NetworkManager just needs to be present.
After=NetworkManager.service incubator-firstboot.service
Wants=NetworkManager.service
# Appliance behaviour: never give up restarting. Without this, systemd's default
# start-rate limit (5 starts / 10 s) would stop the service after a brief boot
# crash-loop and leave the incubator dead until a manual power cycle.
StartLimitIntervalSec=0

[Service]
# Type=notify + WatchdogSec: the app sends READY=1 at startup and pings
# WATCHDOG=1 from its sensor-poll loop (~30 s). If the process HANGS —
# deadlock, wedged event loop — the pings stop and systemd restarts it.
# Restart= only covers exits; the hardware watchdog only covers the
# kernel. This is the missing middle layer.
Type=notify
NotifyAccess=all
WatchdogSec=120
User=root
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=/etc/incubator.env
# Runtime dir for the control-state / command files and preview frames (tmpfs).
# tmpfiles.d creates it at boot too; this covers a manual `systemctl start`.
ExecStartPre=+/bin/mkdir -p /run/incubator
# python -m uvicorn (not the venv console script): with --system-site-packages a
# distro-provided uvicorn has no venv entry point, but the module always imports.
# Single worker (512 MB-class boards), no per-request access log (SD-card
# friendly, the journal is the log), short keep-alive so a phone that walks
# away frees its socket quickly, proxy headers for a reverse proxy in front.
ExecStart=__INSTALL_DIR__/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log --timeout-keep-alive 5 --proxy-headers --log-level info
Restart=always
RestartSec=5
# The web UI yields CPU to the control daemon (Nice=-5) on a busy board.
Nice=5

[Install]
WantedBy=multi-user.target
