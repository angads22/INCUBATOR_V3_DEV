# Incubator v3 — appliance environment configuration
# install.sh copies this to /etc/incubator.env on first install (an existing
# file is never overwritten). Edit it and `sudo systemctl restart incubator
# incubator-control` to apply. Reference board: Raspberry Pi Zero 2 W; every
# value below also works on any other Linux SBC (see docs/PORTING.md).
# Sensitive values (passwords, API keys) should NOT be committed to git.

# --- Database ---
INCUBATOR_DB_URL=sqlite:///./database/incubator.db

# --- Auth ---
# Login is auto-enforced once an operator account is created during onboarding.
# Set this to true to require login even before any account exists.
INCUBATOR_REQUIRE_LOGIN=false
# INCUBATOR_SESSION_SECURE=true   # Mark session cookie Secure (enable behind HTTPS)
# INCUBATOR_SESSION_TTL=604800    # Session lifetime in seconds (default 7 days)

# --- GPIO backend (hardware abstraction) ---
# auto = libgpiod (any board with /dev/gpiochip*) -> RPi.GPIO -> sysfs -> mock.
# Force one with gpiod | rpi | sysfs | mock. Run `python -m app.hal` to see
# what was detected.
GPIO_BACKEND=auto
# Which GPIO chip the bare pin numbers below refer to (e.g. gpiochip0 or
# /dev/gpiochip4). Blank = auto: on a Pi, BCM numbers are resolved by line
# name (GPIO17) on whichever chip exposes them; elsewhere gpiochip0.
GPIO_CHIP=

# --- GPIO pin assignments ---
# Defaults are BCM numbers matching the reference wiring in docs/PI_DEPLOY.md.
# On other boards a pin may also be a line name ("PA12", "GPIO17") or an
# explicit chip:offset ("gpiochip1:5") — see docs/PORTING.md.
GPIO_DHT_PIN=4
GPIO_HEATER_PIN=17
GPIO_FAN_PIN=27
GPIO_TURNER_PIN=22
GPIO_TURNER_DIR_PIN=23
GPIO_CANDLE_PIN=24
GPIO_ALARM_PIN=25
GPIO_LOCK_PIN=12
GPIO_DOOR_PIN=13
GPIO_SETUP_BUTTON_PIN=18
GPIO_RELAY_ACTIVE_LOW=true
# Set to true on dev machines without GPIO hardware (forces the mock backend)
GPIO_MOCK=false

# --- Temperature / humidity sensor ---
# auto = Linux IIO device (e.g. the kernel dht11 overlay) -> I2C probe
# (SHT3x -> AHT20 -> BME280 -> HTU21D) -> adafruit DHT on GPIO_DHT_PIN -> none.
# Force one with iio | sht3x | aht20 | bme280 | htu21d | dht | mock | none.
SENSOR_BACKEND=auto
# I2C bus number (/dev/i2c-<N>) and chip address for the I2C sensors.
# SENSOR_I2C_ADDR=0 means "the sensor's default address" (hex like 0x44 is OK).
SENSOR_I2C_BUS=1
SENSOR_I2C_ADDR=0
# Pin an IIO device (e.g. iio:device0) instead of scanning. Blank = scan.
SENSOR_IIO_DEVICE=

# --- Status LED + sound feedback (the smart-vacuum boot cues) ---
# auto = first on-board status LED found under /sys/class/leds (ACT, led0,
# status, ...); none = disabled; a sysfs LED name; or gpio:<pin> for an
# external LED (e.g. gpio:16). Patterns are listed in README.md.
STATUS_LED=auto
# Buzzer cues on the alarm pin (power-on chirp, setup-mode beeps, Wi-Fi joined
# chime, error buzz). false = silent; alarms still sound.
INCUBATOR_SOUND_FEEDBACK=true

# --- Onboarding / AP ---
INCUBATOR_AP_SSID_PREFIX=Incubator
# Leave BLANK for an open setup network (no Wi-Fi password) — the recommended
# default. The operator joins "Incubator-XXXX", the captive portal opens, and
# they create their account in the wizard. Set a value only for a WPA2 setup AP.
INCUBATOR_AP_PASSWORD=
INCUBATOR_AP_IP=10.42.0.1
INCUBATOR_AUTO_HOTSPOT=true
INCUBATOR_SETUP_BUTTON_HOLD_SECONDS=4.0
# Keep holding the setup button this long (seconds) to arm a FACTORY RESET:
# 3 rapid beeps, then releasing wipes accounts, Wi-Fi and settings and brings
# the setup network back. Must be longer than the setup hold above.
INCUBATOR_FACTORY_RESET_HOLD_SECONDS=15
# Wi-Fi interface used for the setup hotspot and the home network. Blank = the
# first wireless interface found (wlan0 on a Pi, wlp2s0 on a laptop, ...).
WIFI_IFACE=
# Wi-Fi regulatory country (ISO 3166-1 alpha-2). REQUIRED for the radio to
# transmit — on Bookworm the WLAN stays rfkill-blocked until this is set.
# Baked in at image-build time via build_image.sh --wifi-country.
INCUBATOR_WIFI_COUNTRY=US

# --- Camera ---
# auto = picamera2 if installed (Pi camera) -> opencv if /dev/video0 exists
# (USB webcam) -> mock. Or force picamera2 | opencv | mock.
CAMERA_BACKEND=auto
CAMERA_IMAGE_DIR=/var/incubator/captures
CAMERA_RES_W=1920
CAMERA_RES_H=1080
# Low-res live preview (used by the dashboard preview card + MJPEG stream).
CAMERA_PREVIEW_W=640
CAMERA_PREVIEW_H=480
CAMERA_PREVIEW_FPS=1.0
# Live preview card + /api/camera/stream. On by default for the device image so
# the dashboard shows the live camera at launch. Set false to disable (e.g. a
# unit with no camera attached).
CAMERA_STREAM_ENABLED=true
# Transient preview frames live in tmpfs (RAM), never on the SD card.
CAMERA_FRAME_DIR=/run/incubator/frames
# Directory the Testing tab browses for saved captures.
INCUBATOR_CAPTURES_DIR=/var/incubator/captures

# --- Egg-photo storage + auto-prune (protects the SD card) ---
# Labeled egg photos are saved under <captures>/eggs and tracked in the DB. A
# janitor deletes the OLDEST non-pinned photos when the card gets close to full,
# so the appliance never wedges on a full disk. Pinned photos are never deleted.
CAPTURE_STORAGE_ENABLED=true
# Begin pruning when free space drops below this (MB)...
CAPTURE_MIN_FREE_MB=300
# ...and prune until at least this much is free again (hysteresis, MB).
CAPTURE_TARGET_FREE_MB=600
# Optional hard cap on the egg-photo directory (MB). 0 = free-space trigger only.
CAPTURE_MAX_DIR_MB=1024
# Always keep at least this many of the newest photos, even under pressure.
CAPTURE_KEEP_MIN=12
# Optional age cap (days). Photos older than this are pruned first. 0 disables.
CAPTURE_RETENTION_DAYS=0

# --- Vision model ---
# auto | tflite | api | mock
# auto = plug and play: if a model is present at VISION_TFLITE_MODEL it is used,
# else an API if configured, else mock. Inference runs ON COMMAND only (candle /
# analyze) and the model is lazy-loaded, so an idle Pi isn't taxed. Drop a
# .tflite at the path below (or POST it to /api/vision/model) and it just works.
VISION_BACKEND=auto
VISION_TFLITE_MODEL=/var/incubator/models/vision/model.tflite
# For remote vision API (GPT-4V, Claude Vision, Roboflow, custom):
# VISION_BACKEND=api
# VISION_API_URL=https://your-vision-server/analyze
# VISION_API_KEY=your-key-here
VISION_CONFIDENCE_THRESHOLD=0.65

# --- Vision: incubation-stage estimator (Testing tab) ---
# heuristic (works today, no model) | tflite (dropped-in model) | mock (CI)
VISION_STAGE_BACKEND=heuristic
# Drop a trained model here and switch VISION_STAGE_BACKEND=tflite (see the
# model contract documented in app/services/vision_service.py).
VISION_STAGE_MODEL=/var/incubator/models/vision/stage.tflite
# Total incubation length for the species (chicken = 21 days).
INCUBATION_DAYS=21

# --- Vision-driven growth tracking + actions ---
# Candling records each egg's development on a timeline; the growth engine then
# tracks progress and drives incubator actions. With auto-actions on it will
# automatically lock down near hatch (stop turning + raise humidity) and flag
# non-viable eggs. Set false to only *recommend* actions in the API/UI.
VISION_AUTO_ACTIONS=true
# Humidity target (%) applied at lockdown.
VISION_LOCKDOWN_HUMIDITY_PCT=65
# Days before the end of incubation to trigger lockdown.
VISION_LOCKDOWN_DAYS_BEFORE_HATCH=3

# --- Sensor polling ---
SENSOR_POLL_INTERVAL=30
SENSOR_LOG_TO_DB=true

# --- Cloud / OTA (optional) ---
# Set ENABLE_CLOUD_SYNC=true and fill in DOMAIN_API_BASE + DEVICE_SHARED_SECRET
# to enable server heartbeats and over-the-air application updates.
ENABLE_CLOUD_SYNC=false
# DOMAIN_API_BASE=https://your-cloud-api.example.com
# DEVICE_SHARED_SECRET=change-me
HEARTBEAT_INTERVAL_SECONDS=300

# Device identifier — auto-generated by scripts/firstboot.sh on first boot.
# Format: PI-<serial_or_uuid>
# INCUBATOR_DEVICE_ID=PI-XXXXXXXXXXXXXXXX

# OTA poll interval in seconds (0 = managed by systemd incubator-ota.timer).
# Override to a positive value only if you want the Python app itself to poll.
OTA_POLL_INTERVAL_SECONDS=0
# Auto-update from GitHub Releases (app/ota). Set false to pin the version.
OTA_ENABLED=true

# --- Sign in with Google / Apple (optional; buttons hidden when unset) ---
# Google: register a "TVs and Limited Input devices" OAuth client. The device
# shows a short code, the operator enters it at google.com/device — the only
# Google flow that works on a LAN appliance (no HTTPS, no fixed domain).
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# Apple requires HTTPS return URLs, so its leg runs on your fleet's account
# portal, which hands the operator a short-lived signed code to paste into the
# device. The secret verifies those codes (per-fleet shared HMAC key).
# IDENTITY_BROKER_URL=https://account.example.com/link
# IDENTITY_BROKER_SECRET=

# --- Control daemon (Phase 3) ---
# The safety-critical control loop runs as its own always-on service
# (incubator-control.service) so app updates never pause heater/turn control.
# ENABLED by default so a flashed unit regulates temperature out of the box:
# it holds target_temp_c with hysteresis and fails safe (heater OFF) on any
# sensor loss. The web app automatically yields the heater/fan/turner/DHT pins
# to the daemon when this is true (routes hardware commands to it, reads its
# published state) so there is no GPIO contention.
CONTROL_DAEMON_ENABLED=true
CONTROL_INTERVAL=10
CONTROL_HYSTERESIS_C=0.4
TURN_INTERVAL_HOURS=3
# Humidity actuation: off (monitor only) | fan (vent to lower RH)
HUMIDITY_CONTROL_MODE=off
CONTROL_STATE_PATH=/run/incubator/control-state.json
CONTROL_COMMAND_PATH=/run/incubator/control-commands.jsonl
# Where the daemon remembers the last egg-turn time across restarts (so a
# reboot never turns the eggs immediately). Relative to the install dir; the
# default below resolves to /opt/incubator/database/control-persist.json.
# CONTROL_PERSIST_PATH=./database/control-persist.json

# --- Fleet MQTT bus (Phase 1) ---
# Point every unit at the hub's Mosquitto broker. Each unit publishes telemetry
# under <base>/<device_id>/{status,temp,humidity} and accepts commands on
# <base>/<device_id>/cmd. Disabled by default — a standalone unit ignores it.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=fleet
MQTT_TELEMETRY_INTERVAL=30
