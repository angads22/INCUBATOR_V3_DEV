[Unit]
# Periodic OTA update check (driven by incubator-ota.timer). Pulls newer
# GitHub Releases and applies them with health-checked auto-rollback, restarting
# only the web service — the control daemon keeps incubation running.
Description=Incubator OTA update check (GitHub Releases)
After=network-online.target incubator.service
Wants=network-online.target

[Service]
Type=oneshot
# The Python updater reads CONTROL_DAEMON_ENABLED / CONTROL_STATE_PATH from the
# env to gate the post-update health check on the control loop still running.
EnvironmentFile=-/etc/incubator.env
# Tell the agent where the app lives (it defaults to /opt/incubator otherwise,
# which is wrong for a custom --install-dir).
Environment=INCUBATOR_INSTALL_DIR=__INSTALL_DIR__
WorkingDirectory=__INSTALL_DIR__
ExecStartPre=+/bin/mkdir -p /run/incubator
ExecStart=__INSTALL_DIR__/scripts/ota-agent.sh
# Background job: a git fetch + pip install must never starve the control loop
# or the web UI for CPU or SD-card bandwidth.
Nice=10
IOSchedulingClass=idle
